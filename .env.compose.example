# Copy this file to .env in the same folder as docker-compose.yml.
# docker-compose loads .env automatically — no extra flags needed.

# Required for cookie signing in production. Any random string works.
SESSION_SECRET=change-me-to-something-random

# Only needed if you actually want the "Sign in with Google" button to work.
# Leave as-is otherwise — the backend just needs non-empty values to boot.
GOOGLE_CLIENT_ID=placeholder
GOOGLE_CLIENT_SECRET=placeholder
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
